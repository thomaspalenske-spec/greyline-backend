# ==============================================================================
# GreyLine backend environment configuration
#
# Copy this file to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored — NEVER commit real secrets or tokens.
#
# main.py calls load_dotenv(override=False) at startup, so these values are
# loaded into the process environment. PRECEDENCE: a real shell `export` of the
# same variable OVERRIDES the value here. If a flag "won't change" from .env,
# check for a stale `export` in the launching shell (`env | grep GREYLINE`).
# ==============================================================================

# ------------------------------------------------------------------------------
# EXECUTION GOVERNANCE — master safety kill-switches
# Values are case-insensitive "true" / "false".
# ------------------------------------------------------------------------------

# --- Paper execution (read by ExecutionGovernor -> ExecutionAuthorityEngine) ---
# The single switch that arms autonomous paper trading.
#   true  = background scheduler MAY record paper trades when a signal qualifies
#   false = hard kill-switch; ExecutionAuthorityEngine returns KILL_SWITCH_BLOCKED
# Fail-safe: when unset, the code treats this as "false" (blocked). Must be
# explicitly set to "true" to arm autonomous paper trading.
GREYLINE_PAPER_EXECUTION_ENABLED=false

# --- Live trading (read by ExecutionGovernor) ---
# Real-money master switch. Keep false unless intentionally going live.
GREYLINE_LIVE_TRADING_ENABLED=false
# Live order placement; only effective when GREYLINE_LIVE_TRADING_ENABLED=true.
GREYLINE_LIVE_ORDER_PLACEMENT_ALLOWED=false

# --- Live authority gate (read by LiveTradeAuthorityGateEngine) ---
# Separate live-path subsystem. Leave disabled / LOCKED unless enabling live trading.
GREYLINE_LIVE_EXECUTION_ENABLED=false
GREYLINE_ORDER_PLACEMENT_ALLOWED=false
GREYLINE_KILL_SWITCH_STATE=LOCKED

# --- Production endpoint confirmation (read by LiveOrderSafetyGuard) ---
# Real orders will NOT fire against a PRODUCTION broker host (api.tradestation.com)
# unless this is explicitly true. Leave false. Only set true when you consciously
# intend real-money orders against production. Sandbox endpoints do not require it.
GREYLINE_LIVE_PRODUCTION_CONFIRMED=false

# ------------------------------------------------------------------------------
# TRADESTATION BROKER CREDENTIALS  (secrets — fill in your own)
# ------------------------------------------------------------------------------
TRADESTATION_API_KEY=
TRADESTATION_API_SECRET=
TRADESTATION_CALLBACK_URL=
TRADESTATION_PAPER_MODE=true
# Broker API base URL that the live read engines (balance/positions/quotes/orders)
# actually use. NOTE: despite the "SANDBOX" name this may hold a PRODUCTION host
# (https://api.tradestation.com) for real read-only market/account data. The code
# default fails SAFE to the sandbox host (https://sim-api.tradestation.com) when
# unset — it will NOT silently fall back to production.
# WARNING: if live trading is ever enabled, order engines POST to THIS url. Point
# it at production only when you intend real orders.
TRADESTATION_SANDBOX_URL=https://sim-api.tradestation.com
TRADESTATION_SANDBOX_BASE_URL=https://sim-api.tradestation.com
TRADESTATION_MARGIN_ACCOUNT_ID=

# OAuth token material (populated by the auth flow; usually not hand-edited)
TRADESTATION_ACCESS_TOKEN=
TRADESTATION_REFRESH_TOKEN=
TRADESTATION_AUTH_CODE=
TRADESTATION_TOKEN_EXPIRES_IN=
TRADESTATION_TOKEN_SAVED_AT=

# TS_* aliases used by some auth/OAuth engines
TS_CLIENT_ID=
TS_CLIENT_SECRET=
TS_REDIRECT_URI=
TS_AUTH_BASE_URL=
TS_TOKEN_URL=
TS_API_BASE_URL=
TS_MARGIN_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# UNUSUAL WHALES (observation-only signals; usually loaded from .env.local)
# Missing key does not crash — requests fail gracefully as "degraded".
# ------------------------------------------------------------------------------
UNUSUAL_WHALES_API_KEY=
UNUSUAL_WHALES_DAILY_REQUEST_LIMIT=0
UNUSUAL_WHALES_DAILY_RESERVE_PCT=15
UW_FAST_CACHE_SECONDS=300
UW_MEDIUM_CACHE_SECONDS=900
UW_SLOW_CACHE_SECONDS=21600
UW_DEFAULT_CACHE_SECONDS=900

# ------------------------------------------------------------------------------
# RISK GATE (drawdown thresholds consumed by RiskEngine -> master decision)
# ------------------------------------------------------------------------------
GREYLINE_RISK_HALT_DRAWDOWN_PCT=20
GREYLINE_RISK_DEFENSIVE_DRAWDOWN_PCT=10
# Hard position/exposure limits (breach = block ALL new entries until reduced).
GREYLINE_MAX_OPEN_POSITIONS=10
GREYLINE_MAX_SECTOR_EXPOSURE_PCT=50

# ------------------------------------------------------------------------------
# LEGACY / GENERIC (present in existing deployments; kept for compatibility)
# ------------------------------------------------------------------------------
DEV_MODE=false
PAPER_MODE=true
API_KEY=
API_SECRET=
SANDBOX_URL=
CALLBACK_URL=
