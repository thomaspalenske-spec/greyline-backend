from datetime import datetime, timezone
from fastapi import APIRouter

from app.services.greyline_master_decision_engine import GreyLineMasterDecisionEngine
from app.services.paper_trade_ledger_engine import PaperTradeLedgerEngine
from app.services.tradestation_quote_live_engine import TradeStationQuoteLiveEngine


router = APIRouter()


def _parse_trade_time(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except Exception:
        return None


@router.post("/paper-trade-executor/run")
def run_paper_trade_executor():
    decision = GreyLineMasterDecisionEngine().evaluate()

    top_candidate = decision.get("top_candidate", {})
    decision_value = decision.get("decision")

    if decision_value not in ["EXECUTE_SIGNAL_BLOCKED_READ_ONLY", "EXECUTE"]:
        return {
            "system": "GreyLine",
            "source": "PAPER_TRADE_EXECUTOR",
            "paper_trade_recorded": False,
            "reason": "NO_EXECUTE_SIGNAL",
            "decision": decision_value,
            "status": "PAPER_TRADE_EXECUTOR_NO_ACTION",
        }

    symbol = top_candidate.get("symbol")

    if not symbol:
        return {
            "system": "GreyLine",
            "source": "PAPER_TRADE_EXECUTOR",
            "paper_trade_recorded": False,
            "reason": "NO_SYMBOL_FOUND",
            "status": "PAPER_TRADE_EXECUTOR_BLOCKED",
        }

    ledger_engine = PaperTradeLedgerEngine()
    ledger = ledger_engine.history()
    open_trades = [
        trade for trade in ledger.get("trades", [])
        if trade.get("symbol") == symbol and trade.get("status") == "OPEN"
    ]

    if open_trades:
        return {
            "system": "GreyLine",
            "source": "PAPER_TRADE_EXECUTOR",
            "paper_trade_recorded": False,
            "decision": decision_value,
            "symbol": symbol,
            "open_trade_count_for_symbol": len(open_trades),
            "reason": "OPEN_PAPER_POSITION_ALREADY_EXISTS",
            "status": "PAPER_TRADE_EXECUTOR_DUPLICATE_BLOCKED",
        }

    quote_result = TradeStationQuoteLiveEngine().get_quote(symbol)
    quotes = (quote_result.get("response_json") or {}).get("Quotes") or []
    quote_row = quotes[0] if quotes else {}

    try:
        entry_price = float(quote_row.get("Last") or 0)
    except Exception:
        entry_price = 0.0

    trade_time_raw = quote_row.get("TradeTime")
    trade_time = _parse_trade_time(trade_time_raw)
    now = datetime.now(timezone.utc)

    if trade_time is None:
        quote_age_seconds = None
    else:
        quote_age_seconds = round((now - trade_time).total_seconds(), 2)

    market_flags = quote_row.get("MarketFlags") or {}
    is_delayed = bool(market_flags.get("IsDelayed"))

    if quote_result.get("http_status") != 200 or entry_price <= 0:
        return {
            "system": "GreyLine",
            "source": "PAPER_TRADE_EXECUTOR",
            "paper_trade_recorded": False,
            "decision": decision_value,
            "symbol": symbol,
            "quote_status": quote_result.get("status"),
            "http_status": quote_result.get("http_status"),
            "entry_price": entry_price,
            "reason": "LIVE_QUOTE_PRICE_REQUIRED",
            "status": "PAPER_TRADE_EXECUTOR_PRICE_BLOCKED",
        }

    if is_delayed or quote_age_seconds is None or quote_age_seconds > 900:
        return {
            "system": "GreyLine",
            "source": "PAPER_TRADE_EXECUTOR",
            "paper_trade_recorded": False,
            "decision": decision_value,
            "symbol": symbol,
            "entry_price": entry_price,
            "trade_time": trade_time_raw,
            "quote_age_seconds": quote_age_seconds,
            "is_delayed": is_delayed,
            "reason": "FRESH_NON_DELAYED_QUOTE_REQUIRED",
            "status": "PAPER_TRADE_EXECUTOR_STALE_QUOTE_BLOCKED",
        }

    trade = ledger_engine.record_trade(
        symbol=symbol,
        side="BUY",
        quantity=1,
        entry_price=entry_price,
        source="PAPER_TRADE_EXECUTOR_FROM_MASTER_DECISION_LIVE_QUOTE",
    )

    return {
        "system": "GreyLine",
        "source": "PAPER_TRADE_EXECUTOR",
        "paper_trade_recorded": True,
        "decision": decision_value,
        "symbol": symbol,
        "trade": trade,
        "quote_age_seconds": quote_age_seconds,
        "status": "PAPER_TRADE_EXECUTOR_RECORDED",
    }
